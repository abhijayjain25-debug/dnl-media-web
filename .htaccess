# Delhi News Live - Hostinger Apache Configuration
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect /admin, /login, /auth to /#/admin
    RewriteRule ^admin/?$ /#/admin [R=301,L,NE]
    RewriteRule ^login/?$ /#/admin [R=301,L,NE]
    RewriteRule ^auth/?$ /#/admin [R=301,L,NE]
</IfModule>
